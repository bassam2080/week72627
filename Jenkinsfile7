 
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_REPO = 'bassam2080/myapp3'
        IMAGE_TAG  = '4.1'

        EC2_HOST = 'ec2-16-171-150-96.eu-north-1.compute.amazonaws.com'
        EC2_USER = 'ec2-user'
    }

    stages {
           steps {
                withCredentials([
                    file(credentialsId: 'ec2-known-hosts',
                         variable: 'HOST_KEYS')
                ]) {
                    sh '''
                        mkdir -p ~/.ssh
                        chmod 700 ~/.ssh

                        cp "$HOST_KEYS" ~/.ssh/known_hosts
                        chmod 600 ~/.ssh/known_hosts
                    '''
                }
            }
        }
        
        stage('Deploy to EC2') {
            steps {
                echo 'Connecting to AWS EC2 and deploying application'

                sshagent(credentials: ['16.171.150.96']) {
                    sh '''
                        ssh "${EC2_USER}@${EC2_HOST}" \
                          "IMAGE_REPO=${IMAGE_REPO} IMAGE_TAG=${IMAGE_TAG} bash -se" <<'EOF'

                            set -e

                            echo "Checking Docker installation"

                            if ! command -v docker >/dev/null 2>&1; then
                                sudo dnf install -y docker
                            fi

                            sudo systemctl enable --now docker

                            echo "Pulling Docker image"
                            sudo docker pull "$IMAGE_REPO:$IMAGE_TAG"

                            echo "Removing previous application container"
                            sudo docker rm -f myapp-container || true

                            echo "Starting new application container"
                            sudo docker run -d \
                                --name myapp-container \
                                --restart unless-stopped \
                                -p 5000:80 \
                                "$IMAGE_REPO:$IMAGE_TAG"

                            echo "Checking running containers"
                            sudo docker ps
EOF
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment to AWS EC2 completed successfully!'
        }

        failure {
            echo 'Deployment failed. Check Jenkins Console Output.'
        }
    }
}
